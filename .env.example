# ============================================================
# Global Economic Stress Monitoring Platform — Environment Config
# ============================================================
# Copy this file to .env and fill in your real API keys.
# NEVER commit .env to version control.

# ── FRED (Federal Reserve Economic Data) ────────────────────
# Register at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# ── IMF (International Monetary Fund) ───────────────────────
# The IMF JSON RESTful API is public — no key required.
# This placeholder is reserved for future authenticated endpoints.
IMF_API_KEY=

# ── World Bank ───────────────────────────────────────────────
# The World Bank API is public — no key required.
# This placeholder is reserved for premium endpoints.
WORLD_BANK_API_KEY=

# ── General Settings ─────────────────────────────────────────
LOG_LEVEL=INFO
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
LOGS_DIR=logs

# ── Azure / Production ───────────────────────────────────────
# DATABASE_PATH=data/economic_stress.db
# CORS_ORIGINS=https://your-dashboard.azurewebsites.net
# API_BASE_URL=https://your-api.azurewebsites.net   (dashboard only)

# ── Request Settings ─────────────────────────────────────────
REQUEST_TIMEOUT=30
MAX_RETRIES=3
